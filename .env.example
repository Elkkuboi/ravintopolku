# Kopioi tai luo: npm run setup. Tämä tiedosto EI sisällä oikeita avaimia.
APP_PASSWORD=
APP_ORIGIN=http://localhost:3001
APP_BASE_PATH=/
DEV_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
APP_STATE_DIR=./server-state
APP_DIST_DIR=./dist
OPENAI_API_KEY=
# Valitse omaan API-projektiisi saatavilla oleva Responses + structured output -malli.
OPENAI_MODEL=
OPENAI_IMAGE_INPUT=true
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4096
AI_DAILY_REQUEST_LIMIT=30
# Erillinen rajattu liitäntäavain; ei aiopsin hyväksyjäavain.
ILMARI_INTEGRATION_TOKEN=
# Tuleva alihakemistoratkaisu tarvitsee saman arvon myös APP_BASE_PATH:iin.
VITE_APP_BASE=/
