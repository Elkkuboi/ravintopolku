# /etc/ravintopolku/palvelin.toml (root:ravintopolku 0640), aiops ADR-0016. Malli; oikea tiedosto ei ole repossa.
[palvelin]
rp_id = "tyoasema.tailnet.ts.net"
tietokanta = "/srv/aiops/ravintopolku/paivakirja.sqlite"
varmistus = "/srv/aiops/ravintopolku/varmistus"
julkinen = "/srv/aiops/data/public/ravintopolku/paivakirja.json"
sovellus = "/opt/ravintopolku/dist"
# Valinnainen: Ilmarin aterialuonnosten pudotushakemisto (aiops ADR-0026). Ilman riviä laatikko ei lue tiedostoja.
luonnokset = "/srv/aiops/ravintopolku/luonnokset"
# Valinnainen: aiops-välittäjän Unix-soketti (aiops ADR-0025/-0027). Ilman riviä "Kuvaa ateria" ei ole käytössä.
valittaja = "/run/aiops-valittaja/valittaja.sock"

[palvelin.kayttajat]
# Sama lista kuin /etc/aiops/aiops.toml:n [gateway.kayttajat]
"tunnus@github" = "elias"
